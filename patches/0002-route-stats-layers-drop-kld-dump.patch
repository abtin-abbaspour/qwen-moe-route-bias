+    std::vector<float>   rs_key;
+
+    // the selections the graphs registered with set_route_ref -> their unbiased scores
+    std::unordered_map<const ggml_tensor *, const ggml_tensor *> route_refs;
+
+    // the unbiased scores of the lookup's ids: the registered selection is a few views or a CONT above them
+    const ggml_tensor * route_ref_of(const ggml_tensor * sel) const {
+        if (route_refs.empty()) {
+            return nullptr;
+        }
+        const ggml_tensor * q[16];
+        int nq = 0;
+        q[nq++] = sel;
+        for (int h = 0; h < nq; ++h) {
+            const ggml_tensor * t = q[h];
+            const auto it = route_refs.find(t);
+            if (it != route_refs.end()) {
+                return it->second;
+            }
+            for (int j = 0; j < GGML_MAX_SRC && nq < 16; ++j) {
+                if (t->src[j] != nullptr) {
+                    q[nq++] = t->src[j];
+                }
+            }
+        }
+        return nullptr;
+    }
+
+    // with the read of the selected experts: the unbiased scores of the same tokens, into pinned memory
+    void route_stats_read(ggml_backend_t backend, int32_t il, const ggml_tensor * sel) {
+        rs_il = -1;
+        const layer & l = layers[il];
+        if (route_stats_mode() == 0 || l.route_bias == nullptr) {
+            return;
+        }
+        const ggml_tensor * ref = route_ref_of(sel);
+        if (ref == nullptr || ref->type != GGML_TYPE_F32 || !ggml_is_contiguous(ref) || ref->data == nullptr ||
+            ref->ne[0] != (int64_t) l.route_bias_last.size() || (size_t) ggml_nrows(ref)*n_expert_used != ids.size()) {
+            return;
+        }
+        const ggml_tensor * base = base_of(ref);
+        if (base->buffer == nullptr || ggml_backend_buffer_is_host(base->buffer) ||
+            ggml_backend_buft_get_device(ggml_backend_buffer_get_type(base->buffer)) != ggml_backend_get_device(backend)) {
+            return;
+        }
+        const size_t nb = ggml_nbytes(ref);
+        if (nb > rs_cap) {
+            ggml_backend_buffer_type_t buft_pin = ggml_backend_dev_host_buffer_type(ggml_backend_get_device(backend));
+            rs_pin_buf.reset(buft_pin != nullptr ? ggml_backend_buft_alloc_buffer(buft_pin, std::max<size_t>(nb, 256*1024)) : nullptr);
+            rs_pin = rs_pin_buf ? (float *) ggml_backend_buffer_get_base(rs_pin_buf.get()) : nullptr;
+            rs_cap = rs_pin_buf ? ggml_backend_buffer_get_size(rs_pin_buf.get()) : 0;
+            if (rs_pin == nullptr) {
+                return;
+            }
+        }
+        ggml_backend_tensor_get_async(backend, ref, rs_pin, 0, nb);
+        rs_il    = il;
+        rs_n_tok = ggml_nrows(ref);
+        rs_n_exp = ref->ne[0];
+    }
