+    struct bias_range { int a, b; float s; };
+    static float route_bias_for(int32_t il) {
+        static const std::vector<bias_range> ranges = [] {
+            std::vector<bias_range> r;
+            const char * env = getenv("LLAMA_MOE_ROUTE_BIAS_LAYERS");
+            if (env == nullptr || *env == '\0') {
+                return r;
+            }
+            const std::string str(env);
+            size_t pos = 0;
+            while (pos < str.size()) {
+                size_t end = str.find(',', pos);
+                if (end == std::string::npos) {
+                    end = str.size();
+                }
+                const std::string tok = str.substr(pos, end - pos);
+                const size_t dash  = tok.find('-');
+                const size_t colon = tok.find(':');
+                const int a = atoi(tok.c_str());
+                const int b = dash != std::string::npos && (colon == std::string::npos || dash < colon) ? atoi(tok.c_str() + dash + 1) : a;
+                const float sc = colon != std::string::npos ? (float) atof(tok.c_str() + colon + 1) : 1.0f;
+                r.push_back({ a, b, sc });
+                pos = end + 1;
+            }
