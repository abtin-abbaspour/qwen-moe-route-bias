+    // once the ids are in: compare, count, and write the per-token records
+    // record (little endian): u32 step, u16 layer, u8 token in the batch, u8 n, then n entries of u16 expert, u8 flags (1 favoured,
+    // 2 selected, 4 in the unbiased top-k), u8 0, f32 unbiased score; the entries are the top max(k+1, 24) by unbiased score, then
+    // the selected experts outside them
+    void route_stats_take(int32_t il) {
+        if (rs_il != il) {
+            return;
+        }
+        rs_il = -1;
+        const layer & l = layers[il];
+        const int64_t k  = n_expert_used;
+        const int64_t ne = rs_n_exp;
+        if (rs_layer.size() != layers.size()) {
+            rs_layer.assign(layers.size(), route_stats());
+        }
+        if (route_stats_mode() == 2 && !rs_file_tried) {
+            rs_file_tried = true;
+            static int n_open = 0; // a second cache in the process (an MTP context) writes to <path>.1
+            std::string path = getenv("LLAMA_MOE_ROUTE_STATS");
+            if (n_open++ > 0) {
+                path += "." + std::to_string(n_open - 1);
+            }
+            rs_file = fopen(path.c_str(), "wb");
+            if (rs_file == nullptr) {
+                LLAMA_LOG_WARN("llama_moe_cache: cannot write the route records to %s\n", path.c_str());
+            } else {
+                // header: "MRS1", u32 n_expert_used, u32 n_expert, f32 bias, u32 mode (0 add, 1 mul), u32 protect
+                const char * m = getenv("LLAMA_MOE_ROUTE_BIAS_MODE");
+                const char * r = getenv("LLAMA_MOE_ROUTE_PROTECT");
+                const uint32_t h[2] = { (uint32_t) k, (uint32_t) ne };
+                const float    d    = route_bias_value();
+                const uint32_t h2[2] = { (uint32_t) (m != nullptr && strcmp(m, "mul") == 0), (uint32_t) (r != nullptr ? atoi(r) : 0) };
