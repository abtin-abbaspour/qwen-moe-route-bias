+                fwrite(h2, sizeof(uint32_t), 2, rs_file);
+            }
+        }
+        rs_order.resize(ne);
+        rs_flag.resize(ne);
+        const int64_t n_top = std::min<int64_t>(ne, std::max<int64_t>(k + 1, 24));
+        auto fav = [&](int32_t e) {
+            return l.route_bias_last[e] - (l.route_epb.empty() ? 0.0f : l.route_epb[e]) > 0.0f;
+        };
+        static const bool mul = getenv("LLAMA_MOE_ROUTE_BIAS_MODE") != nullptr && strcmp(getenv("LLAMA_MOE_ROUTE_BIAS_MODE"), "mul") == 0;
+        struct rec_e { uint16_t e; uint8_t flags; uint8_t pad; float p; };
+        std::vector<rec_e> rec;
+        rs_key.resize(ne);
+        for (int64_t t = 0; t < rs_n_tok; ++t) {
+            const float   * p = rs_pin + t*ne;
+            const int32_t * s = ids.data() + t*k;
+            float * key = rs_key.data(); // the unbiased selection score: p, plus exp_probs_b where the router has one
+            for (int64_t e = 0; e < ne; ++e) {
+                key[e] = p[e] + (l.route_epb.empty() ? 0.0f : l.route_epb[e]);
+            }
+            std::iota(rs_order.begin(), rs_order.end(), 0);
+            std::partial_sort(rs_order.begin(), rs_order.begin() + n_top, rs_order.end(),
+                [key](int32_t a, int32_t b) { return key[a] > key[b] || (key[a] == key[b] && a < b); });
+            std::fill(rs_flag.begin(), rs_flag.end(), 0);
+            route_stats st;
+            st.tok = 1;
+            for (int64_t r = 0; r < k; ++r) {
+                rs_flag[rs_order[r]] |= 4;
+            }
+            for (int64_t r = 0; r < k; ++r) {
+                const int32_t e = s[r];
+                if (e < 0 || e >= ne) {
+                    continue;
+                }
+                rs_flag[e] |= 2;
+                st.mass_sel += p[e];
+                st.fav_sel  += fav(e) ? 1 : 0;
+            }
+            for (int64_t r = 0; r < k; ++r) {
+                const int32_t e = rs_order[r];
+                st.mass_ref += p[e];
+                st.fav_ref  += fav(e) ? 1 : 0;
+                st.swaps    += (rs_flag[e] & 2) ? 0 : 1;
+            }
+            st.tok_swapped = st.swaps > 0 ? 1 : 0;
+            const float kk = key[rs_order[k - 1]];
+            for (int64_t r = 0; r < k; ++r) {
+                const int32_t e = s[r];
