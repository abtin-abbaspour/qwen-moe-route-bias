+                const uint32_t step = rs_step;
+                const uint16_t lay  = (uint16_t) il;
+                const uint8_t  tb[2] = { (uint8_t) t, (uint8_t) rec.size() };
+                fwrite(&step, sizeof(step), 1, rs_file);
+                fwrite(&lay, sizeof(lay), 1, rs_file);
+                fwrite(tb, 1, 2, rs_file);
+                fwrite(rec.data(), sizeof(rec_e), rec.size(), rs_file);
+            }
+        }
