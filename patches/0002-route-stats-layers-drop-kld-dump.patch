+        uint64_t tok_swapped = 0;    // of which the selection differs from the unbiased top-k
+        uint64_t swaps       = 0;    // experts of the unbiased top-k not selected (= selected experts outside it)
+        uint64_t fav_sel     = 0;    // selected experts the bias favoured
+        uint64_t fav_ref     = 0;    // unbiased top-k experts the bias favoured
+        double   mass_ref    = 0.0;  // sum of the unbiased scores of the unbiased top-k
+        double   mass_sel    = 0.0;  // and of the selection
+        double   gap_sum     = 0.0;  // per swapped-in expert: log score of the unbiased k-th minus its own
+        float    gap_max     = 0.0f;
+        void add(const route_stats & o) {
+            tok += o.tok; tok_swapped += o.tok_swapped; swaps += o.swaps; fav_sel += o.fav_sel; fav_ref += o.fav_ref;
+            mass_ref += o.mass_ref; mass_sel += o.mass_sel; gap_sum += o.gap_sum; gap_max = std::max(gap_max, o.gap_max);
